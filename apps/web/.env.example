# apps/web/.env.example
#
# Reference for every environment variable the web app reads. Copy
# this file to a real `.env.local` (Next.js's standard local
# override) or `.env` on the staging host (untracked - never commit)
# and fill in real values.
#
# This file is the single source of truth for which env vars the
# web app expects: apps/web/src/lib/env.ts is the matching reader,
# and VOC-032-TEST-05 diffs the env names declared here against
# the names that reader actually consumes.
#
# Conventions:
#   * No real credential is committed. Every value below is a
#     placeholder, an obvious fake, or an explicit "unset" sentinel.
#   * NEXT_PUBLIC_* vars are inlined into the client bundle at
#     build time. They are NOT runtime-overridable in production:
#     the CI/CD workflow (T07) must pass the *staging* API URL as
#     a build argument, not a runtime environment variable.
#   * Vars without the NEXT_PUBLIC_ prefix are server-only and
#     read at request time.

# -----------------------------------------------------------------------------
# API base URL
# -----------------------------------------------------------------------------

# [server-only] Base URL the server-side code (Server Components,
# Route Handlers) uses to reach the API. Falls back to
# NEXT_PUBLIC_API_BASE_URL when unset; falls back to
# http://localhost:8080 when both are unset.
API_BASE_URL=http://localhost:8080

# [build-time, client+server] Base URL the browser bundle uses to
# reach the API, and the server-side fallback when API_BASE_URL
# is unset. Next.js inlines NEXT_PUBLIC_* values at build time, so
# this MUST be set as a build argument in the Dockerfile
# (apps/web/Dockerfile, T03) and the CI/CD workflow (T07) must
# pass the staging API URL here, not at runtime. For local
# development, set it to http://localhost:8080 (or the address of
# the locally-running API). For staging, the T07 workflow passes
# https://api-staging.vocanova.site as the build arg.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
