{
  "name": "@vocanova/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit --pretty false",
    "typecheck:e2e": "tsc -p tests/tsconfig.json --noEmit --pretty false",
    "test:e2e": "playwright test",
    "test:middleware": "node --import ./tests/middleware/extensionless-import-resolver.mjs --import ./tests/lib/next-headers-test-hook.mjs --test \"tests/middleware/*.test.ts\" \"tests/lib/*.test.ts\"",
    "test:lighthouse": "node tests/lighthouse/runner.mjs",
    "generate:tokens": "node scripts/generate-tokens-css.mjs"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.69.0",
    "@vocanova/api-client": "workspace:*",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@next/eslint-plugin-next": "16.2.10",
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vocanova/design-tokens": "workspace:*",
    "axe-core": "4.12.1",
    "chrome-launcher": "1.1.2",
    "lighthouse": "13.4.1",
    "tailwindcss": "4.3.3"
  }
}
