# apps/api/.env.example
#
# Reference for every environment variable the production API server
# (apps/api/cmd/api) reads. Copy this file to a real `.env` on the
# staging host (untracked - never commit) and fill in real values.
#
# This file is the single source of truth for which env vars the
# server expects: LoadProductionConfig in apps/api/app/api/production.go
# is the matching reader, and VOC-032-TEST-05 diffs the env names
# declared here against the names that reader actually consumes.
#
# Conventions:
#   * No real credential is committed. Every value below is a
#     placeholder, an obvious fake, or an explicit "unset" sentinel.
#   * Required vars (no usable default) are marked [REQUIRED]. The
#     server refuses to start if any required var is missing.
#   * Vars with a default in code are marked [default: ...]. The
#     default applies if the var is absent; setting the var
#     overrides it.
#   * Vars driven by a DOC-11 kill switch are marked [kill switch].
#     Set to "false" to disable the feature; the server keeps
#     running and returns a stable, documented response instead of
#     crashing.

# -----------------------------------------------------------------------------
# Core server
# -----------------------------------------------------------------------------

# [default: 8080] TCP port the HTTP server binds to. The container
# publishes this port internally only; nginx (apps/web nginx in
# docker-compose) is the only service exposed to the host.
PORT=8080

# [REQUIRED] PostgreSQL connection string the server opens at
# startup. The server pings the database before serving traffic and
# fails fast if the ping fails - a half-configured server never
# starts. Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME?sslmode=...
DATABASE_URL=postgres://vocanova:change-me@postgres:5432/vocanova?sslmode=disable

# [default: staging] Free-form environment tag (e.g. "staging",
# "production"). Recorded in the auth service and aifeedback's
# ServiceConfig.Release field; never interpreted as a code path.
ENVIRONMENT=staging

# -----------------------------------------------------------------------------
# Auth and session
# -----------------------------------------------------------------------------

# [REQUIRED] Public base URL of THIS API, used to build absolute
# magic-link URLs and OAuth callback URLs the auth service emails
# out. For staging, this is https://api-staging.vocanova.site
# (nginx front of the api container - see docker-compose).
BASE_URL=https://api-staging.vocanova.site

# [default: /auth/magic] Path component the magic-link email points
# at, joined to BASE_URL. The web app handles the corresponding
# client-side route.
MAGIC_LINK_PATH=/auth/magic

# [REQUIRED] OAuth redirect URI registered with the upstream
# identity provider (Google, etc.). Must match exactly what the
# provider's OAuth client is configured to allow, including
# scheme/host/path. The T15 real Google OAuth provider uses this
# same value as its GOOGLE_OAUTH_REDIRECT_URI (see apps/web
# .env.example for the founder-side comment about the redirect URI
# being a single shared value across web and api).
OAUTH_REDIRECT_URI=https://api-staging.vocanova.site/auth/oauth/google/callback

# [optional] Comma-separated list of additional OAuth return-to
# URLs the auth service will accept as post-callback redirects
# back to the web app. If unset, the auth service accepts exactly
# the same URI as OAUTH_REDIRECT_URI (no web-app bounce). Set this
# to e.g. https://staging.vocanova.site/onboarding,https://staging.vocanova.site/home
# when the web app needs to round-trip the user through onboarding
# or home after a successful sign-in. Comment out the line below
# to skip setting the var.
OAUTH_REDIRECT_ALLOWLIST=https://staging.vocanova.site/onboarding,https://staging.vocanova.site/home

# [REQUIRED] Domain attribute on the session cookie. Must match the
# domain the browser sees the cookie under; for staging this is
# .vocanova.site (leading dot lets it cover both the apex and the
# api-staging subdomain) or a narrower value if cookies are scoped
# to one host only.
SESSION_COOKIE_DOMAIN=staging.vocanova.site

# [default: true] Whether the session cookie is marked Secure
# (HTTPS-only). Keep true in any environment served over TLS,
# including staging; set to "false" only for local plaintext
# development against `pnpm dev` style mocks.
SESSION_COOKIE_SECURE=true

# [default: 720h] Lifetime of a session cookie, parsed as a Go
# time.Duration string (e.g. "720h", "30m", "24h"). 720h = 30 days,
# matching the auth service's documented session window.
SESSION_LIFETIME=720h

# -----------------------------------------------------------------------------
# AI feedback provider (aifeedback)
# -----------------------------------------------------------------------------

# [default: opencode] AI provider identifier. Currently the only
# supported value is "opencode", which selects
# aifeedback.NewOpenCodeFeedbackProvider. Any other value falls
# back to the mock provider used by tests - never desirable in
# staging, where a real evaluation pass is part of R1's gate.
AI_PROVIDER=opencode

# [default: http://127.0.0.1:4096] Base URL the opencode provider
# POSTs to. The default targets an opencode-server running on the
# api container's loopback. In staging, point this at the real
# opencode host the founder provisions (VOC-032-DEP-03).
AI_PROVIDER_BASE_URL=http://127.0.0.1:4096

# [optional] API key the opencode provider sends as
# Authorization: Bearer <key>. Required for the real provider; if
# unset while AI_PROVIDER=opencode, the production wiring falls
# back to the mock provider. Never commit a real key; load it
# from the staging host's untracked .env only. Comment out the
# line below to skip setting the var.
AI_PROVIDER_API_KEY=change-me-real-opencode-key

# [default: opencode-go/deepseek-v4-pro] Model identifier sent to
# the opencode provider. Override only with a model the opencode
# host actually serves.
AI_PROVIDER_MODEL=opencode-go/deepseek-v4-pro

# [default: 8s] Per-request timeout against the opencode provider,
# parsed as a Go time.Duration string. Increase only with care:
# long timeouts extend the request window the API holds open
# against sentence-practice and review writes.
AI_PROVIDER_TIMEOUT=8s

# -----------------------------------------------------------------------------
# DOC-11 kill switches (per docs/operations/11-devops-and-ci-cd.md §3)
# -----------------------------------------------------------------------------

# [default: true] [kill switch] Master switch for AI feedback
# generation. When "false", aifeedback.NewDisabledGate is wired in
# and every AI-feedback route returns a stable, documented
# non-crash response; non-AI routes are unaffected.
AI_FEATURES_ENABLED=true

# [default: true] [kill switch] Magic-link email sign-in. When
# "false", the auth service rejects magic-link requests. The real
# email sender (T14) and the Fake{} sender are both routed through
# this switch.
EMAIL_MAGIC_LINK_ENABLED=true

# [default: true] [kill switch] Google OAuth sign-in. When
# "false", the auth service rejects Google OAuth initiation. The
# real Google OAuth provider (T15) and the FakeOAuthProvider are
# both routed through this switch.
GOOGLE_OAUTH_ENABLED=true

# [default: true] [kill switch] New-user sign-up. When "false",
# the auth service refuses to create new accounts on any sign-in
# path; existing users can still sign in.
NEW_USER_SIGNUP_ENABLED=true
