-- atlas:txmode transaction
-- VOC-031-T03 (companion to 20260725140001): down-migration for
-- email_change_links. Drops the new table and its indexes; no other
-- table is touched. The companion `.sql` is the source of truth; this
-- file mirrors it for the rollback rehearsal (T11).
DROP INDEX IF EXISTS email_change_links_user_id_idx;
DROP INDEX IF EXISTS email_change_links_active_expiry_idx;
DROP TABLE IF EXISTS email_change_links;
