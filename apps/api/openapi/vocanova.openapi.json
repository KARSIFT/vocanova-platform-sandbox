  "info": {
    "description": "Explicit Vocanova HTTP DTO contract. Internal persistence models are not exposed.",
    "title": "Vocanova API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/auth/logout": {
      "post": {
        "operationId": "Logout",
        "parameters": [
          {
            "description": "Double-submit CSRF token",
            "in": "header",
            "name": "X-CSRF-Token",
            "schema": {
              "description": "Double-submit CSRF token",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "401": {
            "description": "Authentication is required"
          },
          "403": {
            "description": "Invalid CSRF token"
          }
        },
        "summary": "Log out the current session",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/magic-links": {
      "post": {
        "operationId": "RequestMagicLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RequestMagicLinkInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "No Content"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Request a magic sign-in link",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/magic-links/consume": {
      "post": {
        "operationId": "ConsumeMagicLink",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ConsumeMagicLinkInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUser"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Consume a magic sign-in link",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/oauth/google/callback": {
      "get": {
        "operationId": "OAuthCallback",
        "parameters": [
          {
            "description": "The authorization code from the OAuth provider",
            "explode": false,
            "in": "query",
            "name": "code",
            "schema": {
              "description": "The authorization code from the OAuth provider",
              "type": "string"
            }
          },
          {
            "description": "The state parameter returned by the OAuth provider",
            "explode": false,
            "in": "query",
            "name": "state",
            "schema": {
              "description": "The state parameter returned by the OAuth provider",
              "type": "string"
            }
          },
          {
            "description": "An error returned by the OAuth provider",
            "explode": false,
            "in": "query",
            "name": "error",
            "schema": {
              "description": "An error returned by the OAuth provider",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "302": {
            "description": "Redirect to the authenticated application"
          }
        },
        "summary": "Handle the Google OAuth provider callback",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/auth/oauth/google/start": {
      "post": {
        "operationId": "OAuthStart",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OAuthStartInputBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OAuthStartOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorModel"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Start a Google OAuth sign-in flow",
        "tags": ["Authentication"]
      }
    },
    "/api/v1/canonical-words/{wordSlug}": {
      "get": {
        "operationId": "GetCanonicalWord",
        "parameters": [
          {
            "description": "Canonical word slug",
            "in": "path",
            "name": "wordSlug",
            "required": true,
            "schema": {
              "description": "Canonical word slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetWordOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Authentication is required"
          },
          "404": {
            "description": "Word not found"
          }
        },
        "summary": "Get a canonical word with meanings",
        "tags": ["Discovery"]
      }
    },
    "/api/v1/journey-situations": {
      "get": {
        "operationId": "ListJourneySituations",
        "parameters": [
          {
            "description": "Opaque pagination cursor",
            "explode": false,
            "in": "query",
            "name": "after",
            "schema": {
              "description": "Opaque pagination cursor",
              "type": "string"
            }
          },
          {
            "description": "Maximum items to return (1-100)",
            "explode": false,
            "in": "query",
            "name": "limit",
            "schema": {
              "default": 20,
              "description": "Maximum items to return (1-100)",
              "format": "int64",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListSituationsOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "description": "Authentication is required"
          }
        },
        "summary": "List active journey situations",
        "tags": ["Discovery"]
      }
    },
